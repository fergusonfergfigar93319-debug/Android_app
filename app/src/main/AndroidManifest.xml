<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Retrofit / OkHttp / SSE 等网络请求必需；未声明会导致 DNS 解析报 SecurityException -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 从相册选头像等场景；需在运行时申请（后续可在选图前 requestPermissions） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- AR试戴功能 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 搭子定时活动提醒（系统通知）；Android 13+ 需运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 峡谷终端主按钮「两短一长」波形振动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:name=".TxKuApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TX_ku">
        <receiver
            android:name=".feature.chat.reminder.GameActivityReminderReceiver"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TX_ku"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>